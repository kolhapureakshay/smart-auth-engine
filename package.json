{
    "name": "smart-auth-engine",
    "version": "0.1.0",
    "description": "A production-ready, modular authentication engine for Node.js with session intelligence and pluggable architecture",
    "author": "Akshay Kolhapure",
    "license": "MIT",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/kolhapureakshay/smart-auth-engine.git"
    },
    "homepage": "https://github.com/kolhapureakshay/smart-auth-engine#readme",
    "bugs": {
        "url": "https://github.com/kolhapureakshay/smart-auth-engine/issues"
    },
    "keywords": [
        "auth",
        "authentication",
        "jwt",
        "session",
        "rbac",
        "security",
        "nodejs",
        "typescript"
    ],
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "build": "tsup",
        "test": "vitest",
        "lint": "eslint src/**",
        "format": "prettier --write src/**",
        "demo": "ts-node examples/express-demo/index.ts",
        "build:postman": "node scripts/build-postman.js",
        "prepublishOnly": "npm run build && npm run test"
    },
    "dependencies": {
        "dotenv": "^16.4.5",
        "ioredis": "^5.3.2",
        "jose": "^5.2.2",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^20.11.24",
        "@types/uuid": "^9.0.8",
        "eslint": "^8.57.0",
        "prettier": "^3.2.5",
        "ts-node": "^10.9.2",
        "tsup": "^8.0.2",
        "typescript": "^5.3.3",
        "vitest": "^1.3.1",
        "express": "^4.18.2"
    }
}